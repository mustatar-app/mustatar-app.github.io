<?xml version="1.0" encoding="utf-8"?>
<!-- "Month": this month at a glance (today circled, a dot on days with something), and the next two items -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="10dp" android:background="@drawable/widget_bg_dark">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_date" android:textAlignment="viewStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="16sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:maxLines="1" android:text="Mustatar" />
        <TextView android:id="@+id/w_hijri" android:textAlignment="viewStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#99FFFFFF" android:maxLines="1" />
    </LinearLayout>
    <ImageView android:id="@+id/w_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:scaleType="fitCenter" android:contentDescription="@null" />
    <LinearLayout android:id="@+id/w_r1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:visibility="gone">
        <TextView android:id="@+id/w_t1" android:textAlignment="viewStart" android:layout_width="58dp" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#B3FFFFFF" android:maxLines="1" />
        <ImageView android:id="@+id/w_b1" android:layout_width="3dp" android:layout_height="18dp" android:src="@drawable/widget_bar" android:scaleType="fitXY" android:contentDescription="@null" />
        <TextView android:id="@+id/w_n1" android:textAlignment="viewStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="14sp" android:fontFamily="sans-serif" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_r2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="7dp" android:visibility="gone">
        <TextView android:id="@+id/w_t2" android:textAlignment="viewStart" android:layout_width="58dp" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:textColor="#B3FFFFFF" android:maxLines="1" />
        <ImageView android:id="@+id/w_b2" android:layout_width="3dp" android:layout_height="18dp" android:src="@drawable/widget_bar" android:scaleType="fitXY" android:contentDescription="@null" />
        <TextView android:id="@+id/w_n2" android:textAlignment="viewStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:textSize="14sp" android:fontFamily="sans-serif" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
