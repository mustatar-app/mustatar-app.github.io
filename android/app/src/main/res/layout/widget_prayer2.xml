<?xml version="1.0" encoding="utf-8"?>
<!-- "Next prayer": its name, its time, a countdown that moves by itself, and the five prayers of the day as dots -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:background="@drawable/widget_bg_dark">
    <TextView android:id="@+id/w_hijri" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#99FFFFFF" android:maxLines="1" />
    <TextView android:id="@+id/w_pname" android:textAlignment="viewStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFFFF" android:maxLines="1" android:text="Mustatar" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_ptime" android:textAlignment="viewStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="#CCFFFFFF" android:maxLines="1" />
        <Chronometer android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="#FF8CCBFF" android:visibility="gone" />
    </LinearLayout>
    <ImageView android:id="@+id/w_dots" android:layout_width="match_parent" android:layout_height="22dp" android:layout_marginTop="8dp" android:scaleType="fitCenter" android:contentDescription="@null" />
</LinearLayout>
